{
  "name": "bluflow-electron-ui",
  "version": "0.1.0",
  "private": true,
  "description": "Optional BluFlow-Trainer desktop workspace",
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc --noEmit && vite build && node scripts/stamp.cjs",
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "test:startup": "node tests/startup.cjs",
    "test:ui": "node tests/smoke.cjs"
  },
  "dependencies": {
    "dockview-react": "8.5.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "@vitejs/plugin-react": "4.7.0",
    "electron": "45.3.1",
    "playwright": "1.63.0",
    "prettier": "3.10.1",
    "typescript": "5.9.3",
    "vite": "6.4.6"
  }
}
